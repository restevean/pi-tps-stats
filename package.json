{
	"name": "pi-live-throughput",
	"version": "0.3.0",
	"description": "Live tokens/sec throughput display for the Pi coding agent",
	"keywords": [
		"pi-package",
		"extension",
		"tokens",
		"throughput"
	],
	"type": "module",
	"packageManager": "pnpm@11.13.0",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/apetersson/pi-live-throughput.git"
	},
	"homepage": "https://github.com/apetersson/pi-live-throughput#readme",
	"bugs": "https://github.com/apetersson/pi-live-throughput/issues",
	"scripts": {
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"test": "node --experimental-strip-types --test test/*.test.mjs",
		"verify": "pnpm run format:check && pnpm run check && pnpm run lint && pnpm run test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.6",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.67.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
