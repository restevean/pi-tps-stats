{
	"name": "pi-tps-stats",
	"version": "0.1.7",
	"description": "Built with Gentle Shell, for Gentle Shell (works on plain Pi too). Live TPS, token and cache usage above the Pi prompt, plus a /tps stats panel.",
	"keywords": [
		"pi-package",
		"extension",
		"tokens",
		"tps-stats",
		"tps",
		"tokens-per-second",
		"gentle-shell",
		"gentle-pi"
	],
	"type": "module",
	"packageManager": "pnpm@11.13.0",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"license": "MIT",
	"author": "restevean",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/restevean/pi-tps-stats.git"
	},
	"homepage": "https://github.com/restevean/pi-tps-stats#readme",
	"bugs": "https://github.com/restevean/pi-tps-stats/issues",
	"scripts": {
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"test": "node --experimental-strip-types --test test/*.test.mjs",
		"verify": "pnpm run format:check && pnpm run check && pnpm run lint && pnpm run test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@earendil-works/pi-tui": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.6",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.67.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
